{
  "expo": {
    "name": "Sairam Hub",
    "slug": "sairam-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.dakhedu.sairamstudyhub",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/app_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "baac87c9-703e-4612-9608-198a1f5f5ad2"
      }
    },
    "owner": "dhivakar2005"
  }
}
